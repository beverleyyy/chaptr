# Copy to `.env` and fill in from your Supabase project.
# Project Settings → API → Project URL + anon/public key
# Restart Expo after changing env (`npx expo start -c`).

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Leave both blank (or omit .env) to run the offline mock demo.
